{
  "name": "@iiwate/pi-subagents-lite",
  "version": "2.2.0",
  "description": "Lightweight sub-agents for pi — spawn specialized agents with isolated sessions, tools, and models.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-agent",
    "pi-coding-agent",
    "pi-extension",
    "subagents",
    "ai",
    "agents"
  ],
  "author": "IIwate",
  "license": "MIT",
  "packageManager": "bun@1",
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IIwate/pi-subagents-lite.git"
  },
  "homepage": "https://github.com/IIwate/pi-subagents-lite#readme",
  "bugs": {
    "url": "https://github.com/IIwate/pi-subagents-lite/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "typebox": "^1.3.7"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --maxWorkers=4",
    "test:unit": "vitest run --project unit --maxWorkers=4",
    "test:scenarios": "vitest run --project scenarios --maxWorkers=4",
    "test:parallel": "vitest run",
    "test:watch": "vitest",
    "verify-notes": "npx tsx scripts/verify-agent-note-tree.ts && npx tsx scripts/verify-agent-note-format.ts && npx tsx scripts/verify-doc-refs.ts && npx tsx scripts/verify-doc-typecheck.ts && npx tsx scripts/verify-type-equiv.ts",
    "verify-tree": "npx tsx scripts/verify-agent-note-tree.ts",
    "verify-format": "npx tsx scripts/verify-agent-note-format.ts",
    "verify-doc-refs": "npx tsx scripts/verify-doc-refs.ts",
    "verify-typecheck": "npx tsx scripts/verify-doc-typecheck.ts",
    "verify-type-equiv": "npx tsx scripts/verify-type-equiv.ts",
    "archive-note": "npx tsx scripts/archive-agent-note.ts"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7",
    "tsx": "^4.19.0"
  }
}
